{
  "name": "Adresse GN — Système d'adressage QR",
  "short_name": "Adresse GN",
  "description": "Système d'adressage numérique de la République de Guinée. Scannez, posez, consultez vos adresses via QR code.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#ea580c",
  "lang": "fr-GN",
  "dir": "ltr",
  "categories": ["utilities", "productivity", "government"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Scanner un QR",
      "short_name": "Scanner",
      "description": "Scanner un QR de balise pour consulter une adresse",
      "url": "/scan?source=pwa-shortcut",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Mon espace agent",
      "short_name": "Agent",
      "description": "Tableau de bord agent terrain",
      "url": "/agent?source=pwa-shortcut",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "prefer_related_applications": false
}
